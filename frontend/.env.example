# =============================================================================
# Sentra-X Frontend Environment Configuration (.env.example)
# =============================================================================
#
# DUAL-MODE ARCHITECTURE:
#
# 1. OFFLINE / REHEARSAL / EVALUATION MODE (Default):
#    Leave VITE_API_BASE_URL commented out or blank.
#    The React frontend runs entirely in the browser using the in-memory
#    reactive mock store (src/mock/demoData.ts) with realistic simulated
#    latencies (50-120ms). No Docker, PostgreSQL, or Python process is required.
#
# 2. LIVE BACKEND MODE (FastAPI + PostgreSQL):
#    Set VITE_API_BASE_URL to your FastAPI server origin (e.g., http://localhost:8000).
#    ZERO frontend UI components or pages need modification.
#    The API client engine (src/api/client.ts) will:
#      - Automatically route all requests to the live FastAPI endpoints.
#      - Inject 'Authorization: Bearer <token>' from localStorage ('sentrax_jwt_token').
#      - Enforce 'Content-Type: application/json' on requests.
#      - Format 422 Unprocessable Entity Pydantic validation errors cleanly.
#      - Handle 401 Unauthorized (session expiry), 403 Forbidden, and 500 Server Errors.
#
# =============================================================================

# [REQUIRED FOR LIVE BACKEND]
# Base URL for the FastAPI backend (do NOT include a trailing slash)
# Example local development: http://localhost:8000
# Example containerized development: http://backend:8000
VITE_API_BASE_URL=http://localhost:8000

# [OPTIONAL]
# Queue auto-polling interval in milliseconds (default: 30000 = 30 seconds)
# VITE_POLLING_INTERVAL_MS=30000
