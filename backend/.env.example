# ==============================================================================
# Sentra-X Security Operations Workspace Environment Configuration
# ==============================================================================

# PostgreSQL Database Connections (Synchronous and Asynchronous engines)
# Standardized to match docker-compose defaults: user=sentrax, pass=sentrax, db=sentrax
DATABASE_URL=postgresql+psycopg://sentrax:sentrax@localhost:5432/sentrax
DATABASE_URL_ASYNC=postgresql+psycopg_async://sentrax:sentrax@localhost:5432/sentrax

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Operational Mode (true enables standalone/demo development with seeded data)
DEMO_MODE=false

# CORS Allowed Origins (comma-separated list for frontend Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173

# LLM Provider Configuration ("gemini", "claude", "ollama", or "mock")
LLM_PROVIDER=mock
# Local Ollama. In Docker Desktop, use http://host.docker.internal:11434.
# Set TRIAGE_WORKERS=1 below for the first Ollama run.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=90
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Mock-only switches for testing without any API calls:
# MOCK_FAILURE_MODE=timeout   (timeout | invalid_json | http_429 | http_500 | http_400)
# MOCK_FAIL_TIMES=2           (leave out to fail every call)
# MOCK_GULLIBLE=1             (the mock obeys injected text, to exercise FR-3)

# Wazuh 4.x Ingestion Pipeline Configuration (WP-3 Delivery by Atta)
# Note: Wazuh 4.x port 55000 is management/configuration plane only. Alerts are
# streamed directly from /var/ossec/logs/alerts/alerts.json or indexed in
# Wazuh Indexer (Elasticsearch/OpenSearch REST API on port 9200).
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin

# Wazuh ingestion (Part 4)
# WAZUH_INGEST_MODE: replay | poll (indexer polling) | webhook
WAZUH_INGEST_MODE=replay
WAZUH_POLL_INTERVAL_SECONDS=30
WAZUH_MIN_LEVEL=4
WAZUH_VERIFY_TLS=false
WAZUH_WEBHOOK_SECRET=change-me-long-random-string
TRIAGE_WORKERS=32

TRIAGE_ENABLED=true
TRIAGE_SWEEP_SECONDS=5
MOCK_DELAY_MIN_SECONDS=0
MOCK_DELAY_MAX_SECONDS=0
