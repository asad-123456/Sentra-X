# ==============================================================================
# Sentra-X Security Operations Workspace Environment Configuration
# ==============================================================================

# PostgreSQL Database Connections (Synchronous and Asynchronous engines)
DATABASE_URL=postgresql+psycopg://sentrax:sentrax2026@localhost:5432/sentrax_db
DATABASE_URL_ASYNC=postgresql+psycopg_async://sentrax:sentrax2026@localhost:5432/sentrax_db

# Security & JWT Authentication
SECRET_KEY=sentrax-secret-key-2026-cs24082-super-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Operational Mode (true enables standalone/demo development with seeded data)
DEMO_MODE=true

# CORS Allowed Origins (comma-separated list for frontend Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173

# LLM Provider Configuration ("gemini", "claude", or "mock")
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Mock-only switches for testing without any API calls:
# MOCK_FAILURE_MODE=timeout   (timeout | invalid_json | http_429 | http_500 | http_400)
# MOCK_FAIL_TIMES=2           (leave out to fail every call)
# MOCK_GULLIBLE=1             (the mock obeys injected text, to exercise FR-3)

# Wazuh 4.x Ingestion Pipeline Configuration (WP-3 Delivery by Atta)
# Note: Wazuh 4.x port 55000 is management/configuration plane only. Alerts are
# streamed directly from /var/ossec/logs/alerts/alerts.json or indexed in
# Wazuh Indexer (Elasticsearch/OpenSearch REST API on port 9200).
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin