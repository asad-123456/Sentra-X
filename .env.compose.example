# Copy to .env.lab for the isolated mock lab. Use distinct ports and a project name
# for any additional disposable stack. Keep the same database password as its volume.
SENTRAX_BACKEND_ENV_FILE=.env.lab
SENTRAX_DB_PORT=15433
SENTRAX_API_PORT=18001
SENTRAX_HTTPS_PORT=18444

# Replace the placeholders with distinct random hexadecimal values before startup.
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
SECRET_KEY=REPLACE_JWT_SECRET
WAZUH_WEBHOOK_SECRET=REPLACE_WEBHOOK_SECRET

# Seeded accounts are for the disposable lab only.
DEMO_MODE=false
SEED_DEMO_DATA=true
LLM_PROVIDER=mock
WAZUH_INGEST_MODE=webhook

# For a dedicated Ollama receiver, use LLM_PROVIDER=ollama and uncomment these.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_TIMEOUT_SECONDS=90
# TRIAGE_WORKERS=1
