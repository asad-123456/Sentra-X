# --- Database ---
DB_URL=postgresql+psycopg://sentrax:sentrax@localhost:5432/sentrax

# --- LLM (Abdur's side) ---
LLM_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Wazuh ---
WAZUH_API_URL=https://192.168.1.10:55000
WAZUH_API_USER=sentrax_ro
WAZUH_API_PASSWORD=change-me
WAZUH_POLL_INTERVAL_SECONDS=30
WAZUH_MIN_LEVEL=4
WAZUH_VERIFY_TLS=false
WAZUH_INGEST_MODE=replay
WAZUH_WEBHOOK_SECRET=change-me

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Worker ---
TRIAGE_WORKERS=32